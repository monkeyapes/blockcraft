{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blockcraft Server",
  "version": "0.3.0",
  "identifier": "com.blockcraft.host",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": { "cwd": "../..", "script": "npm run host:dev" },
    "beforeBuildCommand": { "cwd": "../..", "script": "npm run host:build" }
  },
  "app": {
    "windows": [
      {
        "title": "Blockcraft Server",
        "width": 940,
        "height": 780,
        "minWidth": 620,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": ["bin/*"]
  }
}
